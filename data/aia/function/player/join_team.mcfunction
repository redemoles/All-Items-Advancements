
#> aia:player/join_team
#
# @within			aia:player/main
#
#
# @description		Intégration dans une équipe
#

execute if score @s aia.dark_blue matches 1 run function aia:player/color/dark_blue
execute if score @s aia.blue matches 1 run function aia:player/color/blue
execute if score @s aia.dark_aqua matches 1 run function aia:player/color/dark_aqua
execute if score @s aia.aqua matches 1 run function aia:player/color/aqua
execute if score @s aia.dark_green matches 1 run function aia:player/color/dark_green
execute if score @s aia.green matches 1 run function aia:player/color/green
execute if score @s aia.yellow matches 1 run function aia:player/color/yellow
execute if score @s aia.gold matches 1 run function aia:player/color/gold
execute if score @s aia.red matches 1 run function aia:player/color/red
execute if score @s aia.dark_red matches 1 run function aia:player/color/dark_red
execute if score @s aia.dark_purple matches 1 run function aia:player/color/dark_purple
execute if score @s aia.light_purple matches 1 run function aia:player/color/light_purple
execute if score @s aia.white matches 1 run function aia:player/color/white
execute if score @s aia.gray matches 1 run function aia:player/color/gray
execute if score @s aia.dark_gray matches 1 run function aia:player/color/dark_gray
execute if score @s aia.black matches 1 run function aia:player/color/black
